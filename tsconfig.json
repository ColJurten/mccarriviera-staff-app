{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app/**/*.ts", "api/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", ".ai"]
}
