@startuml 07-data-contracts
' UML class diagram, detail: clients, contracts, revisions and the contract terms.
' {field} keeps PlantUML from reading attributes with brackets as methods.
!include style.iuml
hide circle
hide empty methods
skinparam nodesep 26
skinparam ranksep 36

class Client <<table: clients>> {
  id : uuid
  title : m | mme [0..1]
  first_name : text [0..1]
  last_name : text
  email : text [0..1]
  phone : text [0..1]
  street, line2, postcode, city : text [0..1]
  state_region, country : text [0..1]
  local_address, local_phone : text [0..1]
  birth_date : date [0..1]
  birth_place_or_country : text [0..1]
  id_doc_type : passport | id_card [0..1]
  id_doc_number, id_doc_country : text [0..1]
  id_doc_issued_on, id_doc_expires_on : date [0..1]
  licence_number : text [0..1]
  licence_issued_on, licence_expires_on : date [0..1]
  --
  {only the last name is needed to save; the
  R-03 list is checked before a Départ is signed}
}

class ClientDocument <<table: client_documents>> {
  id : uuid
  client_id : uuid
  type : licence | id_card | passport | other
  label : text [0..1]
  storage_path, sha256 : text
  size_bytes : integer {≤ 10 MB}
}

class Contract <<table: contracts>> {
  id : uuid
  number : text [0..1] {MCR-YYYY-NNNN, reserved at the preview (F-18)}
  vehicle_id : uuid
  status : draft | awaiting_signature | active | closed | void {SQL functions only}
  current_revision_no : integer
  void_reason : text [0..1]
}

class ContractDriver <<table: contract_drivers>> {
  contract_id : uuid
  client_id : uuid
  role : renter | additional
  --
  {one renter, at most one additional driver}
}

class ContractRevision <<table: contract_revisions>> {
  id : uuid
  contract_id : uuid
  revision_no : integer
  kind : departure | amendment
  terms : ContractTerms {full snapshot}
  terms_version_fr_id, terms_version_en_id : uuid [0..1]
  snapshot_sha256 : text
  reason : text [0..1] {amendments, not printed}
  signed_at : timestamptz [0..1] {departure}
  --
  {editable while unsigned, then insert-only}
}

class ContractTerms <<datatype>> {
  renter, additional driver, vehicle : as printed
  pickup_place, return_place : text [0..1]
  departure_at : timestamptz
  planned_return : date + time [0..1]
  rental_days : integer [0..1]
  flight_train, additional_info : text [0..1]
  intermediary, intermediary_phone : text [0..1]
  rates : 1–3 days, 4–7 days, extra day ×2, package, km included, extra km
  {field} deductible_theft, deductible_accident : numeric(10,2) [0..1]
  card_brand : visa | amex | other [0..1]
  payment_method : cash | card [0..1]
  card_last4 : exactly 4 digits [0..1]
  card_expiry : MM/YY [0..1]
  {field} deposit : numeric(10,2) [0..1]
  departure_agent : staff display name
  pricing : PricingLines
  --
  {no full card number, no CVV (F-09)}
}

class PricingLines <<datatype>> {
  {field} rental, extra_days, extra_km, rental_total_ht : numeric(10,2) [0..1]
  {field} under_25_insurance, extra_driver, delivery : numeric(10,2) [0..1]
  {field} option_1, option_2, option_3, fuel, misc : numeric(10,2) [0..1]
  {field} damage : numeric(10,2) [0..1] {sum of billed estimates}
  {field} total_ht, vat_20, total_ttc, total_prepaid : numeric(10,2) [0..1]
  {field} balance : numeric(10,2) [0..1] {may be negative}
  --
  {typed by staff (F-06), except damage (F-24)}
}

class TermsVersion <<table: terms_versions>> {
  id : uuid
  kind : general_terms | return_authorisation
  language : fr | en
  version_label : text
  effective_from : date
  body_pages : text[] {already split into pages}
}

Client "1" *-- "0..*" ClientDocument
Contract "1" *-- "1..2" ContractDriver
ContractDriver "0..*" --> "1" Client
Contract "1" *-- "1..*" ContractRevision
ContractRevision *-- ContractTerms
ContractTerms *-- PricingLines
ContractRevision "0..*" --> "1..2" TermsVersion : printed with
@enduml
