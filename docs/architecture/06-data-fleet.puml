@startuml 06-data-fleet
' UML class diagram, detail: fleet, reference photos, damage and maintenance.
' {field} keeps PlantUML from reading attributes with brackets as methods.
!include style.iuml
hide circle
hide empty methods
skinparam nodesep 30
skinparam ranksep 40

enum VehicleStatus <<enumeration>> {
  available
  rented
  maintenance
  archived
}

class Vehicle <<table: vehicles>> {
  id : uuid
  plate : text {capitals, unique ignoring spaces and dashes}
  make_model : text
  colour : text [0..1]
  fuel_type : code {default unleaded_95}
  current_km : integer ≥ 0
  {field} current_fuel : integer 0–8 (eighths)
  status : VehicleStatus {SQL functions only}
  current_baseline_id : uuid [0..1]
  notes : text [0..1]
}

class ConditionBaseline <<table: condition_baselines>> {
  id : uuid
  vehicle_id : uuid
  reason : initial | after_repair | manual
  taken_at : timestamptz
  taken_by : uuid
  --
  {insert-only}
}

class Photo <<table: photos>> {
  id : uuid
  baseline_id | damage_id | inspection_id : uuid {exactly one}
  kind : reference | damage | dashboard
  angle : front | rear | left | right (required)
    | 4 corners | interior (optional) [0..1]
  storage_path, sha256 : text
  size_bytes : integer
  imported : boolean {« importée »: picked from the library}
  taken_at : timestamptz
  taken_by : uuid
  --
  {insert-only}
}

class Damage <<table: damages>> {
  id : uuid
  vehicle_id : uuid
  comment : text {at least one photo}
  status : open | repaired {SQL functions only}
  found_stage : departure | return | vehicle_file
  found_contract_id : uuid [0..1]
  found_in_inspection_id : uuid [0..1]
  {field} estimate_amount : numeric(10,2) [0..1] {Retour only}
  estimate_mode : indicative | billed [0..1]
  repaired_in_maintenance_id : uuid [0..1]
  --
  {estimate editable only while its Retour
  waits for the signature (F-24, F-26)}
  repaired_on : date [0..1]
}

class MaintenanceRecord <<table: maintenance_records>> {
  id : uuid
  vehicle_id : uuid
  kind : routine | damage_repair | other
  description : text
  started_on : date
  finished_on : date [0..1]
  odometer_km : integer [0..1]
}

Vehicle "1" *-- "0..*" ConditionBaseline : history
Vehicle "0..*" --> "0..1" ConditionBaseline : current
ConditionBaseline "1" *-- "4..9" Photo : 4 required angles\n+ optional corners, interior
Vehicle "1" *-- "0..*" Damage
Damage "1" *-- "1..*" Photo
Vehicle "1" *-- "0..*" MaintenanceRecord
MaintenanceRecord "0..1" -- "0..*" Damage : repairs
Vehicle ..> VehicleStatus
note as Constraints
All tables include created_at and created_by (diagram 05).
Names/address lines ≤80; comments/notes/descriptions ≤500.
Paths ≤1024; SHA-256 = 64 lowercase hex digits.
The four required angles and damage-photo completeness are
checked by future completion functions, not during staged inserts.
end note
@enduml
