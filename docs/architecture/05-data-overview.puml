@startuml 05-data-overview
' UML class diagram, overview: the 18 tables and how they relate. Fields, and the links of a departure
' inspection to the reference set and the open damage, are on the detail diagrams (06 to 08).
' US-006 physical schema; all 18 tables have UUID id, created_at timestamptz and created_by UUID FK.
!include style.iuml
hide circle
hide empty members
skinparam nodesep 30
skinparam ranksep 45

package "Fleet and condition" #FBFAF6 {
  class Vehicle
  class ConditionBaseline as "Condition baseline\n(reference photo set)"
  class Photo
  class Damage
  class MaintenanceRecord as "Maintenance record"
}

package "Clients" #F8F9FB {
  class Client
  class ClientDocument as "Client document"
}

package "Contracts and evidence" #FBFAF6 {
  class Contract
  class ContractRevision as "Contract revision"
  class ContractDriver as "Contract driver"
  class Inspection
  class Signature
  class StoredSignature as "Stored Retour signature\n(F-28, when switched on)"
  class ContractDocument as "Contract document\n(generated PDF)"
}

package "Shared" #F8F9FB {
  class TermsVersion as "Terms version\n(general terms and the\nRetour authorisation, FR / EN)"
  class StaffProfile as "Staff profile" {
    id, created_by : uuid
    created_at : timestamptz
    display_name : varchar(80)
    auth_user_id : varchar(128) {unique, optional}
  }
  class AuditEvent as "Audit event" {
    id, created_by, row_id : uuid
    created_at : timestamptz
    actor_id : uuid [0..1]
    action, table_name : varchar(80)
    before_values, after_values : jsonb [0..1]
  }
  class ContractNumberCounter as "Contract number counter" {
    id, created_by : uuid
    created_at : timestamptz
    year : integer {unique, 2000–9999}
    last_value : integer {1–9999}
  }
}

Vehicle "1" *-- "0..*" ConditionBaseline
Vehicle "0..*" --> "0..1" ConditionBaseline : current >
ConditionBaseline "1" *-- "4..9" Photo
Vehicle "1" *-- "0..*" Damage
Damage "1" *-- "1..*" Photo
Vehicle "1" *-- "0..*" MaintenanceRecord
MaintenanceRecord "0..1" -- "0..*" Damage : repairs >

Client "1" *-- "0..*" ClientDocument

Vehicle "1" -- "0..*" Contract
Contract "1" *-- "1..*" ContractRevision
Contract "1" *-- "1..2" ContractDriver
ContractDriver "0..*" --> "1" Client
Contract "1" *-- "0..2" Inspection
Inspection "0..1" -- "0..*" Damage : finds (Départ or Retour) >
Inspection "1" *-- "0..*" Photo
Contract "1" *-- "0..*" Signature
Contract "1" *-- "0..1" StoredSignature
Signature "0..1" --> "0..1" StoredSignature : applies >
Contract "1" *-- "0..*" ContractDocument
ContractRevision "0..*" --> "1..2" TermsVersion : printed with >
Contract ..> ContractNumberCounter : number from >
AuditEvent "0..*" --> "0..1" StaffProfile : actor >
note as SchemaConventions
Every table: id uuid PK, created_at timestamptz, created_by uuid FK to staff_profiles.
Names and address lines: 80 characters; comments: 500.
See db/migrations for exact nullability, grants and checks.
end note
@enduml
