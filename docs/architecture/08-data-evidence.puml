@startuml 08-data-evidence
' UML class diagram, detail: what each handover records — inspections, signatures and generated PDFs.
' Grey classes are drawn in full on the previous diagrams.
' {field} keeps PlantUML from reading attributes with brackets as methods.
!include style.iuml
hide circle
hide empty methods
hide empty fields
skinparam nodesep 26
skinparam ranksep 40

class Contract <<table: contracts>> #F5F6F8 {
}
class ContractRevision <<table: contract_revisions>> #F5F6F8 {
}
class ConditionBaseline <<table: condition_baselines>> #F5F6F8 {
}
class Damage <<table: damages>> #F5F6F8 {
}
class Photo <<table: photos>> #F5F6F8 {
}
class TermsVersion <<table: terms_versions>> #F5F6F8 {
}
class PricingLines <<datatype>> #F5F6F8 {
}

class Inspection <<table: inspections>> {
  id : uuid
  contract_id : uuid
  stage : departure | return
  status : in_progress | completed
  at : timestamptz
  km : integer
  {field} fuel : integer 0–8 (eighths)
  car_papers, clean_inside : boolean [0..1]
  clean_outside, gps : boolean [0..1]
  agent_name : text {snapshot}
  baseline_id : uuid [0..1] {departure}
  open_damage_ids : uuid[] {departure, as at signing}
  ras : boolean {return}
  final_pricing : PricingLines [0..1] {return}
  comment : text [0..1]
  --
  {insert-only once completed}
}

class Signature <<table: signatures>> {
  id : uuid
  contract_id : uuid
  revision_no : integer
  stage : departure | return
  mode : in_person | stored
  stored_signature_id : uuid [0..1]
  image_path, image_sha256 : text {the drawing}
  strokes_path : text
  preview_id : uuid
  preview_sha256, sealed_pdf_sha256 : text
  sealed_pdf_id : uuid
  signed_at : timestamptz {server time}
  staff_id : uuid
  device_model, os_version, app_version : text
  ip_address : inet
  snapshot_sha256 : text
  terms_version_ids : uuid[]
  --
  {insert-only}
}

class StoredSignature <<table: stored_signatures>> {
  id : uuid
  contract_id : uuid {one Retour, F-28}
  image_path, image_sha256, strokes_path : text
  authorisation_version_id : uuid
  authorisation_pdf_id : uuid {sealed at capture}
  captured_at : timestamptz
  captured_by : uuid
  km_at_capture : integer [0..1]
  {field} fuel_at_capture : integer 0–8 [0..1]
  status : pending | applied | cancelled {SQL functions only}
  applied_at : timestamptz [0..1]
  applied_by : uuid [0..1]
  cancel_reason : text [0..1]
  --
  {only when the company switches it on;
  no time limit; used once}
}

class ContractDocument <<table: contract_documents>> {
  id : uuid
  contract_id : uuid
  revision_no : integer
  stage : preview | departure | final | authorisation
  language : fr | en
  template_version : text
  terms_version_id : uuid
  storage_path, sha256 : text
  copy_of_id : uuid [0..1] {copies, US-063}
  --
  {insert-only; previews kept, never shared}
}

Contract "1" *-- "0..2" Inspection : departure, return
Contract "1" *-- "0..*" Signature
Contract "1" *-- "0..1" StoredSignature
Signature "0..1" --> "0..1" StoredSignature : applies
Contract "1" *-- "0..*" ContractDocument
Inspection "0..*" --> "0..1" ConditionBaseline : departure reference set
Inspection "0..*" --> "0..*" Damage : open at departure
Inspection "0..1" -- "0..*" Damage : found at this\nDépart or Retour
Inspection "1" *-- "0..1" Photo : dashboard photo
Inspection ..> PricingLines : final amounts
Signature "0..*" --> "1" ContractRevision : covers
Signature "0..*" --> "1" ContractDocument : signs the preview
ContractDocument "0..*" --> "1" TermsVersion : printed with
@enduml
