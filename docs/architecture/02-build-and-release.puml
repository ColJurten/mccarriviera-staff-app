@startuml 02-build-and-release
' UML deployment diagram: how code becomes an installed app and a running back end, and where the developer tests it.
!include style.iuml
left to right direction
skinparam nodesep 26
skinparam ranksep 55

node "Developer PC\nWindows 11 + WSL2" <<device>> as pc {
  component "Code + Metro bundler" as metro
  component "Local stack · Docker Compose\nPostgres · Garage (S3) · Mailpit\nAPI · Documenso · web app" as local
  component "Android emulator\nday-to-day UI work" as emu
}

cloud "GitHub · private repository" <<developer's account>> as gh $DEVELOPER {
  component "Checks on every pull request\ntypes · lint · unit · API · database\ncontract PDFs rendered with Chromium" as ci
  component "Images + web build → private registry\nstaging: on merge to main\nproduction: on a release tag, after approval\nmigrations with dbmate" as rel
}

cloud "Expo EAS" <<developer's account>> as eas $DEVELOPER {
  component "EAS Build\nbuilds started on purpose\n15 iOS builds a month free" as build
  component "EAS Update\nJavaScript-only fixes\nchannels: preview, production" as upd
}

cloud "Apple Developer Program" <<company account>> as apple $COMPANY {
  component "Distribution certificate\nAd Hoc profile\nregistered iPhones (3)" as cert
}

node "Homelab · Proxmox VM" <<developer's>> as lab $DEVELOPER {
  component "Staging stack · stg.developerworkshop.online\nAPI · web app · Documenso · Postgres\nsynthetic data only" as stg
  component "GitHub runner\ndeploys staging" as runner
}

cloud "Scaleway · Paris" <<developer's account>> as scw $DEVELOPER {
  component "Production\nserver · managed Postgres · buckets\nreal data" as prod
}

node "Test iPhone\n(partner's)" <<device>> as tphone {
  artifact "development or\npreview build" as tapp
}
node "Staff iPhone ×2" <<device>> as sphone $DEVICE {
  artifact "production build" as sapp
}

metro --> gh : git push
rel --> runner
runner --> stg
rel --> prod : SSH · compose up
metro --> build : eas build
metro --> upd : eas update
build --> cert : signs with
build --> tapp : install link
build --> sapp : install link
upd ..> sapp : at next launch
upd ..> tapp : at next launch
metro ..> emu : live reload
emu --> stg : HTTPS
tapp --> stg : HTTPS
sapp --> prod : HTTPS
@enduml
