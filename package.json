{
  "name": "mccarriviera-staff-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check . && pnpm -r lint",
    "test": "node scripts/test.mjs",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @mccarriviera/db migrate",
    "db:generate": "pnpm --filter @mccarriviera/db generate",
    "db:check": "pnpm --filter @mccarriviera/db check-generated",
    "db:seed": "pnpm --filter @mccarriviera/db seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
