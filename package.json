{
  "name": "mccarriviera-staff-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.6.5"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.1",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
